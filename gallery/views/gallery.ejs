<!DOCTYPE html>
<html>
<head>
  <title>Photo Gallery</title>
  <style>
    body {
      font-family: Arial;
      text-align: center;
    }
    .gallery {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      padding: 20px;
    }
    img {
      width: 100%;
      height: 150px;
      object-fit: cover;
    }
    .pagination {
      margin: 20px;
    }
    a {
      margin: 5px;
      padding: 8px 12px;
      text-decoration: none;
      border: 1px solid black;
    }
  </style>
</head>
<body>

  <h1>Photo Gallery - Page <%= currentPage %></h1>

  <div class="gallery">
    <% images.forEach(image => { %>
      <img src="<%= image %>" />
    <% }) %>
  </div>

  <div class="pagination">
    <% for(let i = 1; i <= totalPages; i++) { %>
      <a href="/gallery/<%= i %>"><%= i %></a>
    <% } %>
  </div>

</body>
</html>