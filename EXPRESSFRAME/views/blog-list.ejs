<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>All Blog Posts</h1>

    <a href="/blog/new">Create Post</a>
    <ul>
        <% posts.forEach(post=> { %>
            <li>
                <a href="/blog/<%= post.id %>">
                    <%= post.title %>
                </a>
            </li>
            <% }) %>
    </ul>

</body>

</html>